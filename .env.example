# Имя бота для Telegram Login Widget (без @).
# Если пусто — на экране входа показывается мок-кнопка, логинящая тестового пользователя.
VITE_TELEGRAM_BOT=

# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Для публикации в РФ: все HTTP-запросы идут через /supabase на домене Vercel.
VITE_SUPABASE_USE_PROXY=false

# Public VAPID key used by the browser for Web Push subscriptions.
VITE_VAPID_PUBLIC_KEY=
